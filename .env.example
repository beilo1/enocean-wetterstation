# Kopieren nach /opt/wetter-station/.env und mit chmod 600 schützen.
# Beispiel: postgresql://wetter:PASSWORT_HIER@127.0.0.1:5432/wetter
# Passwort mit URL-Sonderzeichen für die DSN prozentkodieren.
DATABASE_URL=
# EnOcean-Sender-ID als acht Hex-Zeichen. DEFAULT_SENSOR_ID übernimmt bei Leerwert SENSOR_ID.
SENSOR_ID=
DEFAULT_SENSOR_ID=
# USB: tatsächlichen Port eintragen, bevorzugt /dev/serial/by-id/…. GPIO: /dev/serial0.
SERIAL_PORT=/dev/ttyUSB0
BAUDRATE=57600
FRONTEND_DIR=/opt/wetter-station/frontend
ROLLUP_REFRESH_SECONDS=60

# Koordinaten paarweise als Dezimalzahlen mit Punkt eintragen oder beide leer lassen.
SITE_NAME=Wetterstation
SITE_LAT=
SITE_LON=

DWD_ENABLED=1
DWD_REFRESH_MINUTES=60
DWD_BACKFILL_DAYS=30
# Für automatische Stationsauswahl leer lassen. Führende Nullen beibehalten.
DWD_STATION_ID=

FORECAST_ENABLED=1
FORECAST_HOURS=12
FORECAST_REFRESH_MINUTES=30
RAIN_GAP_SECONDS=300

# Zum Deaktivieren GOVEE_API_KEY leer lassen. Bei leerer Geräteliste
# werden alle geeigneten Sensoren im Govee-Konto automatisch erkannt.
GOVEE_API_KEY=
GOVEE_POLL_MINUTES=5
GOVEE_DEVICE_IDS=

# Die Govee-Plattform sendet Temperaturen in der Regel in °F.
# Explizite Einheiten in Antworten werden erkannt. Abweichende Geräte
# lassen sich als device|celsius oder device|fahrenheit festlegen.
GOVEE_TEMPERATURE_UNIT=fahrenheit
GOVEE_TEMPERATURE_UNITS=
